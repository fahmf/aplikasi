{
  "expo": {
    "name": "Quizz",
    "slug": "quizz-arabic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "quizz",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d6e5e"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.quizz.arabic"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d6e5e"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.quizz.arabic"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}
